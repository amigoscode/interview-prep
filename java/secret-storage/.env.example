# Copy to .env (gitignored) and fill in. Never commit .env.
#
# A bcrypt hash of the admin password, never the password itself. Create one with:
#   htpasswd -bnBC 12 "" 'your-password' | tr -d ':\n'
#
# Paste it unquoted: `docker run --env-file` keeps quotes as part of the value.
# docker compose interpolates `$`, so there every `$` in the hash must be written `$$`.
ADMIN_PASSWORD_HASH=
